# Copy this file to server/.env and fill in the values.

PORT=3001

# mock = fixed AI answer, no network (default, used in tests and CI)
# live = call GitHub Models with the token below
AI_MODE=mock
GITHUB_TOKEN=
AI_MODEL=openai/gpt-4o-mini

# Signs the login tokens. If empty, the server makes a random one at startup and logins end when it restarts.
# Required when NODE_ENV=production; use a long random value.
JWT_SECRET=
